{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,data/**,docker/**,**/__pycache__/**,.venv/**,openapi.json}"
    }
  },
  "crons": [
    { "path": "/api/internal/cron", "schedule": "30 2 * * *" }
  ]
}
