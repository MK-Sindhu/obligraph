# Copy to .env and adjust. Every variable is optional for local development.

# Postgres (pgvector). docker compose maps the database to localhost:5442.
DATABASE_URL=postgresql+asyncpg://obligraph:obligraph@localhost:5442/obligraph

# Sign access tokens. Use a long random value outside local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- AI -------------------------------------------------------------------
# auto: use Claude when ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN) is set, else the
# offline engine. claude: always Claude. offline: never call a model.
AI_MODE=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Thinking depth per workload: low | medium | high | xhigh | max
EFFORT_EXTRACTION=high
EFFORT_ASSESSMENT=high
EFFORT_COPILOT=medium

# --- Retrieval ------------------------------------------------------------
# fastembed adds local semantic search (install with: uv sync --extra embeddings).
# none = keyword search only.
EMBEDDINGS_PROVIDER=none

# --- Worker ---------------------------------------------------------------
# Run the job worker inside the API process (handy for local dev).
RUN_WORKER_IN_API=true
# Poll regulator RSS feeds on a schedule (sources are seeded disabled; enable them in
# the admin page first).
CRAWL_ENABLED=false
CRAWL_INTERVAL_MINUTES=360

CORS_ORIGINS=http://localhost:3000
# Where users reach the web app (used for SSO redirects).
PUBLIC_URL=http://localhost:3000

# Evidence file storage (a local directory; mount a volume in production).
STORAGE_DIR=./data

# --- SSO (OpenID Connect) -------------------------------------------------
# Enabled when OIDC_ISSUER and OIDC_CLIENT_ID are set. Redirect URI to register with the
# provider: <PUBLIC_URL>/api/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Single sign-on
